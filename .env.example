# HR Agent backend (NestJS) adresi.
# Local: http://localhost:3000
# Production: Vercel panelinde Environment variables altına ekle (deploy edilen backend URL'i).
VITE_HR_API_URL=http://localhost:3000

# HR Agent (Vercel Serverless /api/interview/ask) için Groq anahtarı.
# Vercel > Settings > Environment Variables altına GROQ_API_KEY olarak ekle (client'a sızmaz).
# Yerelde: .env.local içine yaz. (Mısra projesindeki aynı anahtar kullanılabilir.)
# GROQ_API_KEY=
